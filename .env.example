# Browser-safe build-time configuration only. Copy to .env.production.local.
# Leave the Supabase values unset to keep the site browser-local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PUBLIC_SITE_URL=https://your-site.example

# Never add SUPABASE_SERVICE_ROLE_KEY or IP_HASH_SALT to any VITE_* variable.
